{
  "task": {
    "name": "description_optimization",
    "version": "1.0.0",
    "description": "根据产品标题和五点描述生成Walmart英文产品描述"
  },
  "input": {
    "type": "excel",
    "default_path": "input/上架失败再处理_2.xlsx",
    "sheet_name": null,
    "header_row": 1
  },
  "prompt": {
    "template": "prompt.txt"
  },
  "gateway": {
    "name": "tuzi_text",
    "model": "gpt-6-luna",
    "max_tokens": 1200,
    "temperature": 0.1
  },
  "execution": {
    "concurrency": 10,
    "request_start_interval_seconds": 1.0,
    "retry_delay_seconds": 3,
    "validation_retry_count": 0,
    "max_rounds": 3,
    "round_retry_delay_seconds": 60,
    "auto_retry_statuses": [
      "api_transient_failed",
      "validation_failed"
    ]
  },
  "response": {
    "type": "raw_text"
  }
}
