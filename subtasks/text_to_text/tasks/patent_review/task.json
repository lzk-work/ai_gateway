{
  "task": {
    "name": "patent_review",
    "version": "1.0.0",
    "description": "Walmart北美商品专利与版权合规审核"
  },
  "input": {
    "type": "excel",
    "default_path": "input/专利测试.xlsx",
    "sheet_name": null,
    "header_row": 1,
    "image_url_columns": ["主图url", "副图url1", "副图url2", "副图url3", "副图url4", "副图url5", "副图url6"],
    "required_image_url_columns": ["主图url"]
  },
  "prompt": {
    "template": "prompt.txt"
  },
  "gateway": {
    "name": "tuzi_text",
    "model": "gpt-5.6-luna",
    "max_tokens": 6000,
    "temperature": 0.1,
    "image_detail": "auto"
  },
  "execution": {
    "concurrency": 10,
    "request_start_interval_seconds": 1.0,
    "retry_delay_seconds": 3,
    "validation_retry_count": 1
  },
  "response": {
    "type": "fixed_fields",
    "fields": [
      "SKU",
      "产品识别",
      "资料核验情况",
      "专利风险",
      "专利风险等级",
      "专利风险位置",
      "相关专利号",
      "专利权利人",
      "专利法律状态",
      "专利证据",
      "版权风险",
      "版权风险等级",
      "版权风险位置",
      "相关版权/作品",
      "版权权利人",
      "版权证据",
      "总体风险等级",
      "核心风险结论",
      "建议处理方式",
      "检索来源"
    ],
    "required_fields": [
      "SKU",
      "产品识别",
      "资料核验情况",
      "专利风险",
      "专利风险等级",
      "专利风险位置",
      "相关专利号",
      "专利权利人",
      "专利法律状态",
      "专利证据",
      "版权风险",
      "版权风险等级",
      "版权风险位置",
      "相关版权/作品",
      "版权权利人",
      "版权证据",
      "总体风险等级",
      "核心风险结论",
      "建议处理方式",
      "检索来源"
    ],
    "validator": "validator.py"
  }
}
