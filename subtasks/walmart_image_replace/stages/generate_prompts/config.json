{
  "name": "replace_generate_prompts",
  "description": "Replacement generate_prompts; dynamic persisted per-product plan.",
  "execution": {
    "gateway": {
      "name": "tuzi_text"
    },
    "model": {
      "name": "gpt-5.6-luna",
      "candidates": [
        "gpt-5.6-terra",
        "gpt-5.4"
      ],
      "refresh_on_error": true,
      "stream": false,
      "max_tokens": 12000,
      "temperature": null,
      "image_detail": "auto"
    }
  },
  "retry": {
    "retry_delay_seconds": 5
  },
  "limits": {
    "request_start_interval_seconds": 1
  },
  "resume": {
    "skip_success": true
  }
}
