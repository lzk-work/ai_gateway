{
  "name": "generate_sub_images",
  "description": "读取成功 SKU 的副图入参模板，调用总配置选定的平台 生成图片，轮询结果并下载图片。",
  "execution": {
    "model": {
      "name": "gpt-image-2-1k",
      "aspect_ratio": "1:1",
      "quality": "low",
      "resolution": "1K"
    }
  },
  "input": {
    "sheet_name": "Sheet1"
  },
  "columns": {
    "sku": "SKU",
    "reference_image": "参考图片链接",
    "image_name": "图片命名",
    "image_type": "图片类型",
    "status": "下载结果",
    "task_id": "task_id"
  },
  "limits": {
    "poll_interval_seconds": 10,
    "max_wait_seconds": 600,
    "submit_delay_seconds": 1,
    "download_timeout_seconds": 60
  },
  "retry": {
    "max_download_retries": 5,
    "retry_delay_seconds": 5
  },
  "resume": {
    "skip_success": true,
    "poll_existing_task_id": true
  }
}
