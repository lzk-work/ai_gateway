{
  "name": "walmart_call_prompt_model",
  "description": "业务任务 walmart_image_prompt 的第二阶段：读取第一阶段生成的任务，调用所选 OpenAI 兼容网关，校验 JSON，并写出 JSONL 与 Excel 结果。",
  "execution": {
    "gateway": {
      "name": "tuzi_text"
    },
    "model": {
      "name": "gpt-5.6-luna",
      "candidates": [
        "gpt-5.6-terra",
        "gpt-5.4"
      ],
      "refresh_on_error": true,
      "stream": false,
      "max_tokens": 12000,
      "temperature": null,
      "image_detail": "auto"
    }
  },
  "retry": {
    "retry_delay_seconds": 30
  },
  "limits": {
    "request_start_interval_seconds": 1
  },
  "resume": {
    "skip_success": true
  }
}
