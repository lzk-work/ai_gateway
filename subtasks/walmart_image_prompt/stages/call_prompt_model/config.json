{
  "name": "walmart_call_prompt_model",
  "description": "业务任务 walmart_image_prompt 的第二阶段：读取第一阶段生成的任务，调用 BUZZ/OpenAI 兼容接口，校验 JSON，并写出 JSONL 与 Excel 结果。",
  "execution": {
    "gateway": {
      "name": "buzz"
    },
    "model": {
      "name": "gpt-5.6-luna",
      "candidates": [
        "gpt-5.6-terra",
        "gpt-5.4"
      ],
      "refresh_on_error": true,
      "stream": true,
      "max_tokens": 12000,
      "temperature": 0.2,
      "image_detail": "auto"
    }
  },
  "retry": {
    "retry_delay_seconds": 30
  },
  "resume": {
    "skip_success": true
  }
}
