                   "warn_prompt_chars":  40000,
                   "max_images_per_task":  10,
                   "allowed_image_types":  [
                                               "jpg",
                                               "jpeg",
                                               "png",
                                               "webp"
                                           ],
                   "image_detail":  "auto"
               },
    "placeholder_mapping":  {
                                "产品标题":  "标题",
                                "产品五点":  "五点"
                            },
    "include_row_metadata":  true
}
