{
    "name":  "walmart_image_prompt",
    "image_provider": "tuzi",
    "description":  "Walmart 图片生成业务。总配置管理平台、源表、并发、选图和OSS对象模板；阶段配置只保留有效模型参数、列映射、模板和执行规则，批次路径由代码派生。",
    "oss":  {
                "key_template":  "walmart/{sku}/{image_name}.png"
            },
    "image_selection":  {
                "image_type_order":  [
                    "Hero Feature Image",
                    "Lifestyle Scene",
                    "Product Detail Showcase",
                    "Why Choose Us",
                    "Feature Explanation",
                    "Package & Detail / Trust Image"
                ],
                "desired_count":  5
            },
    "image_generation":  {
                              "max_regenerations_per_image":  4
                          },
    "input":  {
                  "excel_path":  "E:/WorkSpace/ai_gateway/subtasks/walmart_image_prompt/input/batch_flow_260912_festival.xlsx",
                  "sheet_name":  "Sheet1"
              },
    "execution":  {
                      "max_records": 3500,
                      "preflight_model":  true,
                      "concurrency":  8,
                      "image_concurrency":  15,
                      "oss_concurrency":  15
                  },
    "review":  {
                    "max_skus_per_file":  1000
                },
    "scheduler":  {
                       "enabled":  true,
                       "interval_seconds":  600,
                       "stop_when_complete":  true,
                       "max_cycles":  null
                   },
    "workflow":  {
                     "buzz_sub_image_count":  4,
                     "generate_prompt_tasks":  true,
                     "call_prompt_model":  true,
                     "generate_main_image":  true,
                     "upload_main_image":  true,
                     "generate_and_download_images":  true,
                     "upload_oss":  true,
                     "build_final_result":  true
                 }
}
