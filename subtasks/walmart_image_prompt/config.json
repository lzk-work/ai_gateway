{
    "name":  "walmart_image_prompt",
    "description":  "Walmart 图片生成提示词业务任务。业务级执行配置放在这里，阶段配置只描述阶段自己的输入、输出、模型和校验规则。",
    "oss":  {
                "prefix":  "develop",
                "key_template":  "develop/{sku}/{image_name}.png"
            },
    "image_selection":  {
                "image_type_order":  [
                    "Hero Feature Image",
                    "Lifestyle Scene",
                    "Product Detail Showcase",
                    "Why Choose Us",
                    "Feature Explanation",
                    "Package & Detail / Trust Image"
                ],
                "desired_count":  6
            },
    "input":  {
                  "excel_path":  "E:/WorkSpace/ai_gateway/subtasks/walmart_image_prompt/input/develop_flow_260821.xlsx",
                  "sheet_name":  "Sheet1"
              },
    "execution":  {
                      "max_records":  10,
                      "preflight_model":  true,
                      "concurrency":  10,
                      "image_concurrency":  10,
                      "oss_concurrency":  15
                  },
    "workflow":  {
                     "generate_prompt_tasks":  true,
                     "call_buzz_model":  true,
                     "generate_and_download_images":  true,
                     "upload_oss":  true,
                     "build_final_result":  true
                 }
}
