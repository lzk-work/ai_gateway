BUZZ_API_KEY=sk-your-buzz-api-key

# Aliyun OSS（图片生成上传 / 沃尔玛图库）
# 实际对象地址形如 oss://zlx-oss-db/images/walmart/{开发SKU}/new_sub{位置}_{开发SKU}.png
# 公网 URL = https://{bucket}.{endpoint}/{default_prefix}/{oss_key}
ALIYUN_OSS_BUCKET=zlx-oss-db
ALIYUN_OSS_ENDPOINT=oss-your-region.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your-oss-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
ALIYUN_OSS_DEFAULT_PREFIX=images

# Walmart Marketplace API（按店铺区分，每店一组 Client ID + Client Secret）
# 用于 walmart_image_replace 任务的 06 提交 / 07 对账
# token 获取：POST /api/v3/token  grant_type=client_credentials  Basic auth(client_id:client_secret)
# 店铺 key 与 subtasks/walmart_image_replace/config.json 的 walmart_api.stores 对应；
# Excel「店铺」列可填 key（store_rlx）或 business_unit（润林轩-沃尔玛），程序自动映射。
WALMART_STORE_RLX_CLIENT_ID=your-rlx-client-id
WALMART_STORE_RLX_CLIENT_SECRET=your-rlx-client-secret

WALMART_STORE_NM_CLIENT_ID=your-nm-client-id
WALMART_STORE_NM_CLIENT_SECRET=your-nm-client-secret
